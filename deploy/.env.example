DB_PASSWORD=replace-with-a-strong-database-password
DB_ROOT_PASSWORD=replace-with-a-different-root-password
JWT_SECRET=replace-with-at-least-32-random-bytes
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=replace-with-a-12-to-72-character-password
MINIO_ACCESS_KEY=communityfix-storage
MINIO_SECRET_KEY=replace-with-a-strong-storage-password
WECHAT_ORDER_TEMPLATE_ID=
WECHAT_ORDER_NUMBER_FIELD=
WECHAT_ORDER_STATUS_FIELD=
DEMO_ENABLED=false
# Mock payments require DEMO_ENABLED=true; never represent real receipts.
BILLING_MOCK_ENABLED=false
# Only local demo accounts may opt in to password synchronization on restart.
DEMO_SYNC_PASSWORDS=false
# Optional independent demo passwords; blank values fall back to BOOTSTRAP_PASSWORD.
DEMO_PROPERTY_PASSWORD=
DEMO_RESIDENT_PASSWORD=
DEMO_WORKER_PASSWORD=
WEB_PORT=8088
CORS_ORIGINS=http://localhost:8088
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Quote subscription template: order number and amount (yuan), configured independently of acceptance notifications.
WECHAT_QUOTE_TEMPLATE_ID=
WECHAT_QUOTE_ORDER_FIELD=character_string3
WECHAT_QUOTE_AMOUNT_FIELD=amount10
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=
# Optional per-scene override: set all three values together, or leave all blank.
AI_REPAIR_ENDPOINT=
AI_REPAIR_API_KEY=
AI_REPAIR_MODEL=
AI_SUPPORT_ENDPOINT=
AI_SUPPORT_API_KEY=
AI_SUPPORT_MODEL=
AI_FAILURE_THRESHOLD=3
AI_COOLDOWN_SECONDS=60
AI_RETENTION_DAYS=30
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_NAMESPACE=communityfix
AI_PROVIDER_REQUESTS_PER_MINUTE=30
RABBITMQ_ENABLED=true
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=communityfix
RABBITMQ_PASSWORD=replace-with-a-strong-rabbitmq-password
RABBITMQ_VHOST=/
